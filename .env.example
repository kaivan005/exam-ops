NODE_ENV=development
PORT=4000
# Aiven API token is only for provisioning/automation. Never commit a real token.
AIVEN_API_TOKEN=replace-with-your-aiven-api-token
AIVEN_PROJECT=replace-with-your-aiven-project
AIVEN_SERVICE=replace-with-your-aiven-service
# Copy the SSL connection string from Aiven and keep sslmode=require.
DATABASE_URL=postgresql://avnadmin:replace-with-password@replace-with-aiven-host:12345/defaultdb?sslmode=require&schema=public
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:5173
APP_IMAGE=ghcr.io/your-org/examops:latest
