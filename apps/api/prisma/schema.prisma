generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  INVIGILATOR
  HOD
}
enum ScheduleStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CANCELLED
}
enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}
enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}
enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum IssueCategory {
  SCHEDULE
  ROOM
  ATTENDANCE
  INCIDENT
  OTHER
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  departmentId String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studentProfile StudentProfile?
  invigilatorProfile InvigilatorProfile?
  createdIssues IssueReport[] @relation("IssueCreator")
  assignedIssues IssueReport[] @relation("IssueAssignee")
  notifications Notification[]
  auditLogs AuditLog[]
  approvals ScheduleApproval[]
  attendance Attendance[]
}

model Department {
  id String @id @default(cuid())
  code String @unique
  name String
  users User[]
  courses Course[]
  subjects Subject[]
  schedules ExaminationSchedule[]
}

model StudentProfile {
  id String @id @default(cuid())
  userId String @unique
  institutionalId String @unique
  program String
  year Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations ExamRegistration[]
}

model InvigilatorProfile {
  id String @id @default(cuid())
  userId String @unique
  employeeId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments InvigilatorAssignment[]
}

model Course {
  id String @id @default(cuid())
  code String @unique
  name String
  departmentId String
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  subjects Subject[]
}

model Subject {
  id String @id @default(cuid())
  code String @unique
  name String
  courseId String
  departmentId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  registrations ExamRegistration[]
  schedules ExaminationSchedule[]
}

model ExaminationSession {
  id String @id @default(cuid())
  name String
  academicYear String
  schedules ExaminationSchedule[]
  registrations ExamRegistration[]
}

model ExamRegistration {
  id String @id @default(cuid())
  studentId String
  subjectId String
  sessionId String
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  session ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  attendance Attendance?
  seat SeatAllocation?
  @@unique([studentId, subjectId, sessionId])
  @@index([studentId])
}

model ExaminationSchedule {
  id String @id @default(cuid())
  sessionId String
  subjectId String
  departmentId String
  startsAt DateTime
  endsAt DateTime
  status ScheduleStatus @default(DRAFT)
  session ExaminationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roomAllocations RoomAllocation[]
  assignments InvigilatorAssignment[]
  approvals ScheduleApproval[]
  issues IssueReport[]
  notifications Notification[]
  @@index([startsAt, endsAt])
}

model ExaminationRoom {
  id String @id @default(cuid())
  code String @unique
  building String
  capacity Int
  roomAllocations RoomAllocation[]
}

model RoomAllocation {
  id String @id @default(cuid())
  scheduleId String
  roomId String
  schedule ExaminationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  room ExaminationRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seats SeatAllocation[]
  assignments InvigilatorAssignment[]
  @@unique([scheduleId, roomId])
}

model SeatAllocation {
  id String @id @default(cuid())
  registrationId String @unique
  roomAllocationId String
  seatNumber String
  registration ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  roomAllocation RoomAllocation @relation(fields: [roomAllocationId], references: [id], onDelete: Cascade)
  @@unique([roomAllocationId, seatNumber])
}

model InvigilatorAssignment {
  id String @id @default(cuid())
  scheduleId String
  invigilatorId String
  roomAllocationId String?
  schedule ExaminationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  invigilator InvigilatorProfile @relation(fields: [invigilatorId], references: [id], onDelete: Restrict)
  roomAllocation RoomAllocation? @relation(fields: [roomAllocationId], references: [id], onDelete: SetNull)
  @@unique([scheduleId, invigilatorId])
}

model Attendance {
  id String @id @default(cuid())
  registrationId String @unique
  markedById String
  present Boolean
  markedAt DateTime @default(now())
  registration ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  markedBy User @relation(fields: [markedById], references: [id], onDelete: Restrict)
}

model ScheduleApproval {
  id String @id @default(cuid())
  scheduleId String
  approverId String
  decision ApprovalDecision @default(PENDING)
  comments String?
  decidedAt DateTime?
  schedule ExaminationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  approver User @relation(fields: [approverId], references: [id], onDelete: Restrict)
  @@unique([scheduleId, approverId])
}

model IssueReport {
  id String @id @default(cuid())
  creatorId String
  assigneeId String?
  scheduleId String?
  category IssueCategory
  priority IssuePriority @default(MEDIUM)
  status IssueStatus @default(OPEN)
  title String
  description String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User? @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  schedule ExaminationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
}

model Notification {
  id String @id @default(cuid())
  userId String
  scheduleId String?
  title String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule ExaminationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  @@index([userId, readAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
}
